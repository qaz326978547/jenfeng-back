NODE_ENV=development
PORT=8080

# MySQL connection (same production database as the legacy Laravel app;
# shared with another CMS system — do not run destructive migrations)
DATABASE_URL="mysql://user:password@host:3306/database"

# Redis (BullMQ queue backend)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Mail (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="JINFENG"
RECIPIENT_EMAIL=

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://laborservice5690.com,https://www.laborservice5690.com,https://jinfengv2.zeabur.app,https://jinfeng-front.zeabur.app
